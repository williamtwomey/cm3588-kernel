#!/bin/bash
# Boot-time diagnostics for test kernels on the A/B SD card (cm3588-kernel tools/).
#  - 6.1.192-rk192: dump PCIe/GPIO/pinmux state to /root/diag-<kver>-<ts>/, retry the
#    r8125 PCIe port (fe190000) with a late re-bind, and reboot (falls back to slot b)
#    if there's still no eth0, since without the NIC nobody can reach the box.
#  - 6.1.141-fsfix2 on a mixed DTB (the one-off fallback boot that runs on slot a's
#    DTB, see cm3588-slot status): reboot once more to get slot b's own DTB.
K=$(uname -r)
log() { echo "$*" | systemd-cat -t cm3588-bootdiag; echo "$*" >> "$D/run.log"; }
case "$K" in
6.1.192-*)
  D=/root/diag-$K-$(date +%Y%m%d-%H%M%S); mkdir -p "$D"
  sleep 20
  dmesg > "$D/dmesg-0.txt"
  cat /sys/kernel/debug/gpio > "$D/gpio.txt" 2>&1
  cat /sys/kernel/debug/pinctrl/pinctrl-rockchip-pinctrl/pinmux-pins > "$D/pinmux.txt" 2>&1
  cat /sys/kernel/debug/pinctrl/pinctrl-rockchip-pinctrl/pins > "$D/pins.txt" 2>&1
  cat /sys/kernel/debug/regulator/regulator_summary > "$D/regulators.txt" 2>&1
  ls -l /sys/bus/pci/devices/ > "$D/pci.txt" 2>&1
  ls /sys/kernel/debug/ > "$D/debugfs.txt" 2>&1
  for p in /sys/kernel/debug/fe1?0000.pcie; do [ -d "$p" ] && for f in "$p"/*; do echo "== $f"; cat "$f"; done; done > "$D/pcie-debugfs.txt" 2>&1
  for t in 1 2 3; do
    if ip link show eth0 >/dev/null 2>&1; then break; fi
    log "try $t: re-bind fe190000.pcie"
    echo fe190000.pcie > /sys/bus/platform/drivers/rk-pcie/bind 2>>"$D/run.log"
    sleep 15
    dmesg > "$D/dmesg-try$t.txt"
  done
  ip -br link > "$D/ip.txt"
  if ip link show eth0 >/dev/null 2>&1; then
    log "eth0 present, staying up"
  else
    log "no eth0, rebooting back to slot b"
    sync; systemctl reboot
  fi ;;
6.1.141-fsfix2)
  D=/root; M=/run/cm3588-bootdiag.mixed
  # FriendlyElec's DTB has the hdptxphy_hdmi0 node (hdmiphy@fed60000); the rk192 DTB doesn't
  if [ ! -e /proc/device-tree/hdmiphy@fed60000 ] && [ ! -e /root/.bootdiag-mixed-$(date +%Y%m%d%H) ]; then
    touch /root/.bootdiag-mixed-$(date +%Y%m%d%H)
    echo "fsfix2 on a foreign DTB, rebooting once for slot b's own" | systemd-cat -t cm3588-bootdiag
    sleep 20; sync; systemctl reboot
  fi ;;
esac
