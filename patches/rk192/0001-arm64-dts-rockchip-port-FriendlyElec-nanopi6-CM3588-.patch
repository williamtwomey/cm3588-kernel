+		/* GPIO3 B0-B7 */
+		"PIN_33", "",
+		"PIN_07", "PIN_16",
+		"PIN_18", "PIN_29",
+		"PIN_31", "PIN_12",
+		/* GPIO3 C0-C7 */
+		"", "", "PIN_11", "PIN_13",
+		"", "", "", "",
+		/* GPIO3 D0-D7 */
+		"", "", "", "",
