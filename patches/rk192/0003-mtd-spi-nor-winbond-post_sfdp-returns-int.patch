From ba5a01543c8ac54b3a9db303798e1b16a19672ca Mon Sep 17 00:00:00 2001
From: Will Twomey <william.twomey@gmail.com>
Date: Wed, 11 Nov 2026 13:04:59 -0600
Subject: [PATCH 03/14] mtd: spi-nor: winbond: post_sfdp returns int

v6.1.192 makes spi_nor_fixups.post_sfdp return int; Rockchip's winbond
post_sfdp hook was still void.
---
 drivers/mtd/spi-nor/winbond.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/drivers/mtd/spi-nor/winbond.c b/drivers/mtd/spi-nor/winbond.c
index 42b51d3efb46..c28c2d05d074 100644
--- a/drivers/mtd/spi-nor/winbond.c
+++ b/drivers/mtd/spi-nor/winbond.c
@@ -226,13 +226,15 @@ static void winbond_nor_late_init(struct spi_nor *nor)
 		nor->params->otp.ops = &winbond_nor_otp_ops;
 }
 
-static void winbond_nor_post_sfdp(struct spi_nor *nor)
+static int winbond_nor_post_sfdp(struct spi_nor *nor)
 {
 	/*
 	 * All winbond flash support 35H command, but some flash do
 	 * not accurately feedback information after SDFP param parsing.
 	 */
 	nor->flags &= ~SNOR_F_NO_READ_CR;
+
+	return 0;
 }
 
 static const struct spi_nor_fixups winbond_nor_fixups = {
-- 
