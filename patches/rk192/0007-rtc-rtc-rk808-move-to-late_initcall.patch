From bd3469f2ad60e29ba6006c075afd877a5d325d0f Mon Sep 17 00:00:00 2001
From: jensen <jensenhuang@friendlyarm.com>
Date: Mon, 5 Jun 2023 16:02:56 +0800
Subject: [PATCH 07/14] rtc: rtc-rk808: move to late_initcall

This gives other drivers the opportunity to register as rtc0.

Signed-off-by: jensen <jensenhuang@friendlyarm.com>
(cherry picked from commit 83c0188077d0d3b3f514aaaa9ddfcedd2c0cb1d9)
---
 drivers/rtc/rtc-rk808.c | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/drivers/rtc/rtc-rk808.c b/drivers/rtc/rtc-rk808.c
index 28029b593d02..31f9e5aa8c76 100644
--- a/drivers/rtc/rtc-rk808.c
+++ b/drivers/rtc/rtc-rk808.c
@@ -509,7 +509,17 @@ static struct platform_driver rk808_rtc_driver = {
 	},
 };
 
-module_platform_driver(rk808_rtc_driver);
+static int __init rk808_rtc_driver_init(void)
+{
+	return platform_driver_register(&rk808_rtc_driver);
+}
+late_initcall(rk808_rtc_driver_init);
+
+static void __exit rk808_rtc_driver_exit(void)
+{
+	platform_driver_unregister(&rk808_rtc_driver);
+}
+module_exit(rk808_rtc_driver_exit);
 
 MODULE_DESCRIPTION("RTC driver for the rk808 series PMICs");
 MODULE_AUTHOR("Chris Zhong <zyw@rock-chips.com>");
-- 
