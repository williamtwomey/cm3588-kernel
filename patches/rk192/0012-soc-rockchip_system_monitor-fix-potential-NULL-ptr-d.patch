From 69d9aacae82a0ab2008d66ab7d71cbb3066d8b88 Mon Sep 17 00:00:00 2001
From: jensen <jensenhuang@friendlyarm.com>
Date: Fri, 15 Sep 2023 16:30:19 +0800
Subject: [PATCH 12/14] soc: rockchip_system_monitor: fix potential NULL ptr
 deref

Signed-off-by: jensen <jensenhuang@friendlyarm.com>
(cherry picked from commit 4502d05b0520cb78ca92a3b1da5f1287cb3c22b1)
---
 drivers/soc/rockchip/rockchip_system_monitor.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/drivers/soc/rockchip/rockchip_system_monitor.c b/drivers/soc/rockchip/rockchip_system_monitor.c
index 00c0d1895b46..3df4ae2a4d2a 100644
--- a/drivers/soc/rockchip/rockchip_system_monitor.c
+++ b/drivers/soc/rockchip/rockchip_system_monitor.c
@@ -1226,6 +1226,11 @@ rockchip_system_monitor_wide_temp_init(struct monitor_dev_info *info)
 	if (!system_monitor->tz)
 		return;
 
+	if (!system_monitor->tz) {
+		dev_err(info->dev, "thermal zone is NULL\n");
+		return;
+	}
+
 	ret = thermal_zone_get_temp(system_monitor->tz, &temp);
 	if (ret || temp == THERMAL_TEMP_INVALID) {
 		dev_err(info->dev,
@@ -1404,6 +1409,11 @@ rockchip_system_monitor_register(struct device *dev,
 	if (!devp)
 		return ERR_PTR(-EINVAL);
 
+	if (!devp->check_rate_volt) {
+		dev_warn(dev, "using default check_rate_volt\n");
+		devp->check_rate_volt = rockchip_monitor_check_rate_volt;
+	}
+
 	info = kzalloc(sizeof(*info), GFP_KERNEL);
 	if (!info)
 		return ERR_PTR(-ENOMEM);
-- 
2.53.0

