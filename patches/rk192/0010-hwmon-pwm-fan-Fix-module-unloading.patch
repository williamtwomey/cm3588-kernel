From 7f21c0557bac83bf1344fbcdc4c0b47d51f47092 Mon Sep 17 00:00:00 2001
From: jensen <jensenhuang@friendlyarm.com>
Date: Tue, 16 Apr 2024 14:23:39 +0800
Subject: [PATCH 10/14] hwmon: (pwm-fan) Fix module unloading

Signed-off-by: jensen <jensenhuang@friendlyarm.com>
(cherry picked from commit f4d02110eb9a5e770ee6dcb3aee7b332355eb209)
---
 drivers/hwmon/pwm-fan.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/drivers/hwmon/pwm-fan.c b/drivers/hwmon/pwm-fan.c
index 559c30947269..fc8ebb5b2d81 100644
--- a/drivers/hwmon/pwm-fan.c
+++ b/drivers/hwmon/pwm-fan.c
@@ -751,6 +751,20 @@ static int pwm_fan_probe(struct platform_device *pdev)
 	return 0;
 }
 
+static int pwm_fan_remove(struct platform_device *pdev)
+{
+	struct pwm_fan_ctx *ctx = platform_get_drvdata(pdev);
+
+	if (ctx->thermal_notifier_is_ok) {
+		ctx->thermal_notifier_is_ok = false;
+		rockchip_system_monitor_unregister_notifier(&ctx->thermal_nb);
+	}
+
+	pwm_fan_switch_power(ctx, false);
+
+	return 0;
+}
+
 static void pwm_fan_shutdown(struct platform_device *pdev)
 {
 	struct pwm_fan_ctx *ctx = platform_get_drvdata(pdev);
@@ -783,6 +797,7 @@ MODULE_DEVICE_TABLE(of, of_pwm_fan_match);
 
 static struct platform_driver pwm_fan_driver = {
 	.probe		= pwm_fan_probe,
+	.remove		= pwm_fan_remove,
 	.shutdown	= pwm_fan_shutdown,
 	.driver	= {
 		.name		= "pwm-fan",
-- 
2.53.0

